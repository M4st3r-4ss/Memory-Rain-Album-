# Memory Rain Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=8080

# Authentication (REQUIRED - Change these!)
USER_PASSWORD=00000000
ADMIN_PASSWORD=00000000

# Session Configuration
SESSION_SECRET=memory-rain-secret-key-2024

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ATTEMPT_WINDOW_MINUTES=5

# File Upload Configuration
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=jpeg,jpg,png,gif,mp4,mov,avi,webm

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Trust Proxy (set to true if behind reverse proxy)
TRUST_PROXY=true

# Production Mode
NODE_ENV=development
